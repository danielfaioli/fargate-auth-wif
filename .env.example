# Copy to .env and fill in. .env is git-ignored and excluded from the Docker image.
# Format is compatible with `docker run --env-file .env`: KEY=VALUE, no quotes, no `export`.

# --- Application (read by app/main.py) ---
AWS_REGION=<aws-region>
AZURE_TENANT_ID=<entra-tenant-id>
AZURE_CLIENT_ID=<managed-identity-client-id>
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID=<sql-warehouse-id>

# --- Infrastructure reference (not read by the app) ---
AWS_ACCOUNT_ID=<aws-account-id>
AWS_ISSUER=https://<uuid>.tokens.sts.global.api.aws
TASK_ROLE_ARN=arn:aws:iam::<aws-account-id>:role/<task-role-name>
ECS_CLUSTER=<ecs-cluster-name>
ECR_IMAGE=<aws-account-id>.dkr.ecr.<aws-region>.amazonaws.com/<repository>:<tag>
UAMI_PRINCIPAL_ID=<managed-identity-object-id>
